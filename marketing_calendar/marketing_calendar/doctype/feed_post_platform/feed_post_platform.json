 "fields": [
  {
   "fieldname": "platform",
   "fieldtype": "Select",
   "in_list_view": 1,
   "label": "Platform",
   "options": "LinkedIn\nX\nInstagram\nBlog",
   "reqd": 1
  },
  {
   "depends_on": "eval:doc.platform != 'Blog'",
   "fieldname": "social_account",
   "fieldtype": "Link",
   "in_list_view": 1,
   "label": "Connected Account",
   "options": "Feed Social Account"
  },
  {
   "default": "Pending",
   "fieldname": "status",
   "fieldtype": "Select",
   "in_list_view": 1,
   "label": "Status",
   "options": "Pending\nPublishing\nPublished\nFailed",
   "read_only": 1
  },
  {
   "fieldname": "cb_content",
   "fieldtype": "Column Break"
  },
  {
   "depends_on": "eval:doc.platform != 'Blog'",
   "description": "This platform's own post copy — each platform has its own caption and character limit.",
   "fieldname": "caption",
   "fieldtype": "Text",
   "label": "Caption / Content"
  },
  {
   "depends_on": "eval:doc.platform != 'Blog'",
   "fieldname": "link_url",
   "fieldtype": "Data",
   "label": "Link / URL"
  },
  {
   "depends_on": "eval:doc.platform == 'Blog'",
   "description": "Only existing Blog Posts can be scheduled here — this connector schedules an already-written post, it doesn't author one.",
   "fieldname": "blog_post",
   "fieldtype": "Link",
   "label": "Blog Post",
   "mandatory_depends_on": "eval:doc.platform == 'Blog'",
   "options": "Blog Post"
  },
  {
   "depends_on": "eval:doc.platform != 'Blog'",
   "collapsible": 1,
   "fieldname": "sb_platform_options",
   "fieldtype": "Section Break",
   "label": "Platform-specific options"
  },
  {
   "depends_on": "eval:doc.platform == 'X'",
   "fieldname": "x_reply_settings",
   "fieldtype": "Select",
   "label": "Who Can Reply",
   "options": "Everyone\nFollowing\nMentioned"
  },
  {
   "depends_on": "eval:doc.platform == 'X'",
   "fieldname": "x_sensitive_media",
   "fieldtype": "Check",
   "label": "Mark Media as Sensitive"
  },
  {
   "depends_on": "eval:doc.platform == 'LinkedIn'",
   "description": "JSON list of {name, urn} pairs — LinkedIn can't look people up by name for us, so each name has to be paired with the person's actual LinkedIn member URN. At publish time, that name's first matching occurrence in the caption gets wrapped as a real @mention link.",
   "fieldname": "linkedin_mentions",
   "fieldtype": "Small Text",
   "label": "Tagged People (LinkedIn)"
  },
  {
   "fieldname": "cb_options",
   "fieldtype": "Column Break"
  },
  {
   "depends_on": "eval:doc.platform == 'Instagram'",
   "description": "Posted as the first comment instead of in the caption.",
   "fieldname": "instagram_first_comment",
   "fieldtype": "Text",
   "label": "First Comment (hashtags)"
  },
  {
   "depends_on": "eval:doc.platform == 'Instagram'",
   "description": "Up to 2 Instagram usernames, comma-separated — they'll get a collab invite and need to accept it before the post shows on their profile too.",
   "fieldname": "instagram_collaborators",
   "fieldtype": "Data",
   "label": "Collaborators"
  },
  {
   "collapsible": 1,
   "fieldname": "sb_results",
